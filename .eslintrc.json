{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": ["@qawolf/playground-*", "@qawolf/runner-*", "@qawolf/pom"]
      }
    ]
  },
  "ignorePatterns": ["dist", "node_modules"]
}
